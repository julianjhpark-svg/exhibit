# Copy to .env and fill in. Never commit .env.

# Return answer_key labels instead of calling a model. Turn OFF once the verifier works.
MOCK=1

# Model provider. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=
MODEL=gpt-5-mini

# Prune gateway (https://www.withprune.com). When set, all model calls go through Prune:
# spend caps, cached/duplicate calls, provider key stays out of the app.
PRUNE_BASE_URL=
PRUNE_API_KEY=

# Guardrails for failure handling (R3)
MAX_SOURCES=5
MAX_PDF_MB=20
REQUEST_TIMEOUT_S=45
