# Copy to .env and fill in. Never commit .env.

# Return answer_key labels instead of calling a model. Turn OFF once the verifier works.
MOCK=1

# Model provider. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
MODEL=gpt-5-mini

# Prune gateway (https://www.withprune.com). To use it, change ONLY the two lines above:
#   LLM_BASE_URL=<prune base url>
#   LLM_API_KEY=<prune key>
# and delete the provider key. Spend caps + cached duplicate calls are the pitch.

# Pipeline knobs
TOP_K=8
MAX_CONCURRENCY=4
REQUEST_TIMEOUT_S=45

# Guardrails for failure handling (R3)
MAX_SOURCES=5
MAX_PDF_MB=20
